12:00:05 variable:n (25 -> 15): block 1
  line 1 (block 1) n gt 10 [update]: 15 is true
  line 2 (block 1) n gt 20 [update]: 15 is false
  1: variable zzm-update-then = update-then
12:00:08 variable:n (15 -> 5): block 0
  line 1 (block 1) n gt 10 [update]: 5 is false
  line 2 (block 1) n gt 20 [update]: 5 is false
